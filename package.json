{
  "name": "lvbt-labs",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "bootstrap": "node .lvbt/web-platform/packages/cli/src/cli.mjs bootstrap",
    "preflight": "node .lvbt/web-platform/packages/cli/src/cli.mjs preflight",
    "doctor": "tsx packages/labs-cli/src/cli.ts doctor",
    "provision": "tsx packages/labs-cli/src/cli.ts provision",
    "standards:update": "node .lvbt/web-platform/standards/web-platform-cli.ts update",
    "standards:check": "node .lvbt/web-platform/standards/web-platform-cli.ts check",
    "build": "turbo run build",
    "build:archive": "turbo run build:archive",
    "dev": "turbo run dev",
    "preview": "tsx packages/labs-cli/src/preview.ts",
    "lab": "tsx packages/labs-cli/src/cli.ts",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:archive": "turbo run test:archive --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && markdownlint-cli2 && lvbt check && turbo run lint check-types test validate",
    "check:fix": "pnpm format && markdownlint-cli2 --fix && turbo run lint -- --fix",
    "prepare": "git config --local core.hooksPath .githooks",
    "deploy": "lvbt deploy",
    "deploy:cf:dry-run": "pnpm build && pnpm release:dry-run",
    "deploy:plan": "tsx packages/labs-cli/src/deployment-cli.ts",
    "deploy:affected": "tsx packages/labs-cli/src/deployment-apply.ts",
    "audit": "lvbt audit",
    "postinstall": "lvbt setup-record",
    "release:smoke": "pnpm --filter @lasvegasfortransit/labs-cli release:smoke",
    "test:release": "pnpm --filter @lasvegasfortransit/labs-cli test:release",
    "release:dry-run": "tsx packages/labs-cli/src/release-dry-run.ts",
    "security:dependencies": "pnpm audit --audit-level=high",
    "security:secrets": "lvbt check secrets"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@lasvegasfortransit/cli": "file:.lvbt/web-platform/packages/cli",
    "@lasvegasfortransit/prettier-config": "file:.lvbt/web-platform/packages/prettier-config",
    "@playwright/test": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:",
    "@lasvegasfortransit/web-platform": "file:.lvbt/web-platform/packages/web-platform"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.20.0"
  }
}
