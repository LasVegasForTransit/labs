{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["catalog/**", "retired/**", "apps/*/lab.config.ts"],
  "globalEnv": ["CI", "GITHUB_REF", "GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:archive": {
      "dependsOn": ["build:archive"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build:archive": {
      "dependsOn": ["^build"],
      "outputs": ["dist-archive/**"]
    },
    "@lvbt/labs-tooling#test:e2e": {
      "dependsOn": ["@lvbt/lab-home#build", "@lvbt/lab-transit-funding#build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
