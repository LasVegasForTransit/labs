{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "catalog/**",
    "retired/**",
    "apps/*/lab.config.ts",
    ".lvbt/web-platform.json",
    ".lvbt/tooling.json",
    ".github/workflows/**"
  ],
  "globalEnv": [
    "CI",
    "GITHUB_REF",
    "GITHUB_RUN_ID",
    "GITHUB_RUN_ATTEMPT",
    "GITHUB_SHA",
    "LVBT_MIGRATION_BROWSER_ACCEPTANCE",
    "LVBT_REQUIRE_ANALYTICS",
    "PUBLIC_LVBT_CWA_TOKEN",
    "PLAYWRIGHT_BASE_URL",
    "TARGET",
    "LVBT_RELEASE_APP"
  ],
  "globalPassThroughEnv": [
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ANALYTICS_READ_TOKEN",
    "LVBT_SKIP_PREVIEW_SERVER",
    "NODE_AUTH_TOKEN",
    "PATH",
    "GITHUB_OUTPUT",
    "CF_ACCESS_CLIENT_ID",
    "CF_ACCESS_CLIENT_SECRET",
    "LVBT_PR_NUMBER"
  ],
  "tasks": {
    "@lasvegasfortransit/labs-cli#build": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "sync": {
      "outputs": [".astro/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "sync"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:archive": {
      "dependsOn": ["build:archive"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build:archive": {
      "dependsOn": ["^build"],
      "outputs": ["dist-archive/**"]
    },
    "@lasvegasfortransit/labs-cli#test:e2e": {
      "dependsOn": [
        "@lasvegasfortransit/lab-home#build",
        "@lasvegasfortransit/lab-transit-funding#build"
      ],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "validate": {
      "dependsOn": ["build", "//#security:dependencies", "//#security:secrets"],
      "cache": false
    },
    "@lasvegasfortransit/labs-cli#validate": {
      "dependsOn": [
        "@lasvegasfortransit/lab-home#build",
        "@lasvegasfortransit/lab-transit-funding#build",
        "//#security:dependencies",
        "//#security:secrets",
        "@lasvegasfortransit/lab-transit-funding#validate"
      ],
      "cache": false
    },
    "@lasvegasfortransit/lab-transit-funding#validate": {
      "dependsOn": [
        "build",
        "build:archive",
        "//#security:dependencies",
        "//#security:secrets",
        "@lasvegasfortransit/lab-home#validate"
      ],
      "cache": false
    },
    "//#security:dependencies": {
      "cache": false,
      "outputs": []
    },
    "//#security:secrets": {
      "cache": false,
      "outputs": []
    },
    "@lasvegasfortransit/lab-home#validate": {
      "dependsOn": [
        "build",
        "lint",
        "check-types",
        "test",
        "^test",
        "@lasvegasfortransit/lab-transit-funding#lint",
        "@lasvegasfortransit/lab-transit-funding#check-types",
        "@lasvegasfortransit/lab-transit-funding#test",
        "@lasvegasfortransit/lab-runtime#test",
        "@lasvegasfortransit/labs-home-deploy#lint",
        "@lasvegasfortransit/labs-home-deploy#check-types",
        "@lasvegasfortransit/labs-home-deploy#test",
        "@lasvegasfortransit/labs-transit-funding-deploy#lint",
        "@lasvegasfortransit/labs-transit-funding-deploy#check-types",
        "@lasvegasfortransit/labs-transit-funding-deploy#test",
        "//#security:dependencies",
        "//#security:secrets"
      ],
      "cache": false
    }
  }
}
