{
  "name": "@lasvegasfortransit/lab-task-checkins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:archive": "node scripts/archive.mjs",
    "lint": "eslint . --max-warnings 0",
    "check-types": "wrangler types worker-configuration.d.ts --include-runtime=false --strict-vars=false --check && tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 tests/core/*.test.ts tests/integrations/*.test.ts tests/storage/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e/manual-updates.spec.ts",
    "validate": "pnpm test:e2e"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:",
    "@lasvegasfortransit/eslint-config": "file:../../.lvbt/web-platform/packages/eslint-config",
    "miniflare": "catalog:",
    "@lasvegasfortransit/lab-runtime": "workspace:*"
  }
}
