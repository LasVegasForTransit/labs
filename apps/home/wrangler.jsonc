{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lvbt-labs-home",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
