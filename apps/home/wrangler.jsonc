{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lvbt-labs-home",
  "account_id": "2557b5c2e166292ded0f8425b73075e9",
  "routes": [{ "pattern": "labs.lasvegasfortransit.org", "custom_domain": true }],
