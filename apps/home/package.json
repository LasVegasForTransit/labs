{
  "name": "@lvbt/lab-home",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:archive": "env PUBLIC_LVBT_CWA_TOKEN= LVBT_REQUIRE_ANALYTICS= astro build --outDir dist-archive && tsx ../../packages/labs-cli/src/check-archive.ts dist-archive",
    "dev": "astro dev --host 127.0.0.1 --port 4320",
    "preview": "astro preview --host 127.0.0.1 --port 4320",
    "lint": "eslint . --max-warnings 0",
    "sync": "astro sync",
    "check-types": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:",
    "@lasvegasfortransit/analytics": "catalog:",
    "@lvbt/brand": "workspace:*",
    "@lvbt/labs-cli": "workspace:*",
    "@lvbt/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@lasvegasfortransit/eslint-config": "file:../../.lvbt/web-platform/packages/eslint-config",
    "@lasvegasfortransit/playwright-config": "file:../../.lvbt/web-platform/packages/playwright-config",
    "@lasvegasfortransit/typescript-config": "file:../../.lvbt/web-platform/packages/typescript-config",
    "@lasvegasfortransit/vitest-config": "file:../../.lvbt/web-platform/packages/vitest-config",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
