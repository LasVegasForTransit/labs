{
  "name": "@lasvegasfortransit/labs-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./archive": "./src/archive-browser.ts",
    "./manifest": "./src/manifest.ts",
    "./catalog": "./src/catalog.ts"
  },
  "scripts": {
    "build": "tsx src/archive-release-command.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm test:e2e && env LVBT_MIGRATION_BROWSER_ACCEPTANCE=1 vitest run tests/migration-export-acceptance.test.ts && tsx src/release-dry-run.ts",
    "release:smoke": "tsx src/release-smoke.ts",
    "test:release": "playwright test --config playwright.release.config.ts",
    "preview:acceptance": "tsx src/pr-release-browser.ts"
  },
  "dependencies": {
    "@lasvegasfortransit/lab-runtime": "workspace:*",
    "@lasvegasfortransit/web-platform": "file:../../.lvbt/web-platform/packages/web-platform",
    "prettier": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lasvegasfortransit/eslint-config": "file:../../.lvbt/web-platform/packages/eslint-config",
    "@lasvegasfortransit/playwright-config": "file:../../.lvbt/web-platform/packages/playwright-config",
    "@lasvegasfortransit/typescript-config": "file:../../.lvbt/web-platform/packages/typescript-config",
    "@lasvegasfortransit/vitest-config": "file:../../.lvbt/web-platform/packages/vitest-config",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
